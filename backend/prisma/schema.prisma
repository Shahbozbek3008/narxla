generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum MaterialCategory {
  FLOOR
  WALL
  CEILING
  CONSTRUCTION
  INSULATION
  ELECTRICAL
  PLUMBING
}

enum ObservationStatus {
  ACCEPTED
  PENDING_REVIEW
  REJECTED
}

enum ObservationSource {
  SCRAPER
  MANUAL
}

enum ScrapeOutcome {
  OK
  FAILED
  BLOCKED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Material {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  unit           String
  category       MaterialCategory
  referencePrice Int
  listings       Listing[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("materials")
}

model Store {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  baseUrl       String
  priceSelector String?
  crawlDelayMs  Int       @default(3000)
  active        Boolean   @default(true)
  listings      Listing[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("stores")
}

model Listing {
  id            String             @id @default(cuid())
  material      Material           @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId    String
  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId       String
  url           String             @unique
  title         String?
  packSize      Decimal            @default(1) @db.Decimal(10, 3)
  active        Boolean            @default(true)
  lastCheckedAt DateTime?
  lastOutcome   ScrapeOutcome?
  lastError     String?
  failureCount  Int                @default(0)
  observations  PriceObservation[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([materialId])
  @@index([storeId, active])
  @@map("listings")
}

model PriceObservation {
  id         String            @id @default(cuid())
  listing    Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String
  price      Int
  unitPrice  Int
  status     ObservationStatus
  source     ObservationSource
  reason     String?
  observedAt DateTime          @default(now())
  reviewedAt DateTime?

  @@index([listingId, status, observedAt(sort: Desc)])
  @@index([status, observedAt])
  @@map("price_observations")
}

model ScrapeRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  total      Int       @default(0)
  accepted   Int       @default(0)
  flagged    Int       @default(0)
  failed     Int       @default(0)
  blocked    Int       @default(0)

  @@index([startedAt(sort: Desc)])
  @@map("scrape_runs")
}

model PriceReport {
  id           String       @id @default(cuid())
  estimateId   String
  materialCode String?
  comment      String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt(sort: Desc)])
  @@map("price_reports")
}

model JobLock {
  name        String   @id
  owner       String
  lockedUntil DateTime

  @@map("job_locks")
}

model LabourRate {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  unit      String
  minPrice  Int
  price     Int
  maxPrice  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("labour_rates")
}

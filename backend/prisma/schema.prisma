generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum MaterialCategory {
  FLOOR
  WALL
  CEILING
  CONSTRUCTION
  INSULATION
  ELECTRICAL
  PLUMBING
}

enum ObservationStatus {
  ACCEPTED
  PENDING_REVIEW
  REJECTED
}

enum ObservationSource {
  SCRAPER
  MANUAL
}

enum ScrapeOutcome {
  OK
  FAILED
  BLOCKED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Material {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  unit           String
  category       MaterialCategory
  referencePrice Int
  listings       Listing[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("materials")
}

model Store {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  baseUrl       String
  priceSelector String?
  crawlDelayMs  Int       @default(3000)
  active        Boolean   @default(true)
  listings      Listing[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("stores")
}

model Listing {
  id            String             @id @default(cuid())
  material      Material           @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId    String
  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId       String
  url           String             @unique
  title         String?
  packSize      Decimal            @default(1) @db.Decimal(10, 3)
  active        Boolean            @default(true)
  lastCheckedAt DateTime?
  lastOutcome   ScrapeOutcome?
  lastError     String?
  failureCount  Int                @default(0)
  observations  PriceObservation[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([materialId])
  @@index([storeId, active])
  @@map("listings")
}

model PriceObservation {
  id         String            @id @default(cuid())
  listing    Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String
  price      Int
  unitPrice  Int
  status     ObservationStatus
  source     ObservationSource
  reason     String?
  observedAt DateTime          @default(now())
  reviewedAt DateTime?

  @@index([listingId, status, observedAt(sort: Desc)])
  @@index([status, observedAt])
  @@map("price_observations")
}

model ScrapeRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  total      Int       @default(0)
  accepted   Int       @default(0)
  flagged    Int       @default(0)
  failed     Int       @default(0)
  blocked    Int       @default(0)

  @@index([startedAt(sort: Desc)])
  @@map("scrape_runs")
}

model PriceReport {
  id           String       @id @default(cuid())
  estimateId   String
  materialCode String?
  comment      String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt(sort: Desc)])
  @@map("price_reports")
}

model JobLock {
  name        String   @id
  owner       String
  lockedUntil DateTime

  @@map("job_locks")
}

model LabourRate {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  unit      String
  minPrice  Int
  price     Int
  maxPrice  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("labour_rates")
}

enum Plan {
  free
  project
  pro
}

enum Quality {
  eco
  mid
  pre
}

enum EstimateStatus {
  ready
  draft
  sent
}

enum PaymentProvider {
  manual
}

model User {
  id             String     @id @default(cuid())
  phone          String?    @unique
  telegramId     BigInt?    @unique
  name           String     @default("")
  region         String     @default("Toshkent")
  district       String     @default("")
  reserve        Int        @default(10)
  quality        Quality    @default(mid)
  notifyPrice    Boolean    @default(true)
  notifyTelegram Boolean    @default(false)
  notifyNews     Boolean    @default(false)
  plan           Plan       @default(free)
  planExpiresAt  DateTime?
  sessions       Session[]
  estimates      Estimate[]
  payments       Payment[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt(sort: Desc)])
  @@map("otp_challenges")
}

model Estimate {
  id         String         @id @default(cuid())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  input      Json
  status     EstimateStatus @default(ready)
  shareToken String?        @unique
  sharedAt   DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@map("estimates")
}

model Payment {
  id        String          @id @default(cuid())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  plan      Plan
  amount    Int
  provider  PaymentProvider
  reference String?
  periodEnd DateTime?
  paidAt    DateTime        @default(now())

  @@index([userId, paidAt(sort: Desc)])
  @@map("payments")
}

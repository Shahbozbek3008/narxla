NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://smetachi:smetachi@localhost:5433/smetachi?schema=public"
CORS_ORIGINS=http://localhost:3000
ADMIN_API_KEY=change-me-to-a-long-random-string-of-32-chars-or-more

SCRAPER_ENABLED=true
SCRAPER_CRON="0 3 * * 1"
SCRAPER_TIMEZONE=Asia/Tashkent
SCRAPER_USER_AGENT="NarxlaBot/1.0 (+https://narxla.uz/bot)"
SCRAPER_REQUEST_TIMEOUT_MS=15000
SCRAPER_DEFAULT_DELAY_MS=3000

PRICE_FRESH_DAYS=45
PRICE_MIN_SOURCES=3
PRICE_REVIEW_THRESHOLD=0.3

AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_HOURLY_LIMIT=5
SMS_DRIVER=log
OTP_FIXED_CODE=123456
TELEGRAM_BOT_TOKEN=
